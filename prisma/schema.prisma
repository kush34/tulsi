generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?   @unique
  avatarUrl     String?
  passwordHash  String?
  role          Role      @default(PATIENT)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient       PatientProfile?
  doctor        DoctorProfile?
  medicalProfile MedicalProfile?
  otps          Otp[]
  auditEvents   AuditEvent[]
  accounts      Account[]
  sessions      Session[]
  historySessions HistorySession[]

  @@map("users")
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  dob       DateTime?
  gender    String?
  bloodType String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model MedicalProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  allergies     Json?
  conditions    Json?
  medications   Json?
  surgeries     Json?
  familyHistory Json?
  socialHistory Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes MedicalProfileChange[]

  @@map("medical_profiles")
}

model MedicalProfileChange {
  id        String   @id @default(cuid())
  profileId String
  changedBy String
  changes   Json
  ip        String?
  createdAt DateTime @default(now())

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("medical_profile_changes")
}

model DoctorProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  specialty               String
  licenseNumber           String?
  yearsOfExp              Int?
  bio                     String?
  education               String?
  languages               String?
  consultationFee         Int?
  address                 String?
  availableForConsultation Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctor_profiles")
}

model Otp {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otps")
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuditEvent {
  id        String     @id @default(cuid())
  userId    String?
  event     String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@map("audit_events")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum HistorySessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  PATIENT_REVIEW
  COMPLETED
  CANCELLED
}

enum HistoryAnswerInputType {
  TEXT
  VOICE
  TOUCH
  OTHER
}

enum HistoryFactSource {
  PATIENT
  DOCUMENT
  AI_EXTRACTION
  DOCTOR
}

enum HistoryFactVerification {
  UNVERIFIED
  PATIENT_CONFIRMED
  DOCTOR_VERIFIED
  REJECTED
}

enum HistoryFlagType {
  RED_FLAG
  CONTRADICTION
}

enum HistoryFlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model HistorySession {
  id               String              @id @default(cuid())
  patientId        String
  appointmentId    String?
  framework        String              @default("MODERN")
  status           HistorySessionStatus @default(NOT_STARTED)
  currentSection   String              @default("CHIEF_COMPLAINT")
  currentQuestionId String?
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  patient         User @relation(fields: [patientId], references: [id], onDelete: Cascade)
  questions       HistoryQuestion[]
  answers         HistoryAnswer[]
  facts           HistoryFact[]
  flags           HistoryFlag[]
  clinicalHistory ClinicalHistory?

  @@index([patientId, status])
  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
  @@map("history_sessions")
}

model HistoryQuestion {
  id           String  @id @default(cuid())
  sessionId    String
  section      String
  question     String
  questionType String  @default("FREE_TEXT")
  sequence     Int
  metadata     Json?
  createdAt    DateTime @default(now())

  session HistorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers HistoryAnswer[]

  @@index([sessionId, sequence])
  @@map("history_questions")
}

model HistoryAnswer {
  id                String  @id @default(cuid())
  sessionId         String
  questionId        String
  rawAnswer         String
  normalizedAnswer  Json?
  inputType         HistoryAnswerInputType @default(TEXT)
  createdAt         DateTime @default(now())

  question HistoryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session  HistorySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@map("history_answers")
}

model HistoryFact {
  id               String                  @id @default(cuid())
  sessionId        String
  section          String
  field            String
  value            Json
  source           HistoryFactSource       @default(AI_EXTRACTION)
  confidence       Float?
  verification     HistoryFactVerification @default(UNVERIFIED)
  sourceReference  String?
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime                @default(now())

  session HistorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, section])
  @@index([sessionId, verification])
  @@map("history_facts")
}

model HistoryFlag {
  id           String           @id @default(cuid())
  sessionId    String
  type         HistoryFlagType
  severity     String?
  status       HistoryFlagStatus @default(OPEN)
  description  String
  details      Json?
  resolution   String?
  resolvedById String?
  detectedAt   DateTime         @default(now())
  resolvedAt   DateTime?

  session HistorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, type, status])
  @@map("history_flags")
}

model ClinicalHistory {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  sections    Json
  summary     String?
  isVerified  Boolean  @default(false)
  generatedAt DateTime @default(now())

  session HistorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("clinical_histories")
}
